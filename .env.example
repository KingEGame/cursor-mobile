# Hermes Phone bridge — PC-side environment
# The bridge is the Hermes Gateway plugin `server/phone_bridge`
# (installed at ~/.hermes/plugins/phone_bridge). Values are read from the
# gateway plugin config or from environment variables.

# Enable the phone bridge platform (default: off)
PHONE_BRIDGE_ENABLED=true

# Listen port (default 8097)
# PHONE_BRIDGE_PORT=8097

# Bind address: use your PC's Tailscale IP/hostname for phone reachability.
# Prefer Tailscale interface only; 0.0.0.0 only when Tailscale ACLs protect
# the port or ufw restricts it to the LAN + tailscale0.
# PHONE_BRIDGE_HOST=0.0.0.0

# Let paired phones talk to the agent (the transport already requires a
# device token; pairing is still mandatory)
# PHONE_BRIDGE_ALLOW_ALL_USERS=false

# Test overrides (used by smoke/e2e only — never point these at the real ~/.hermes)
# PHONE_BRIDGE_DB_PATH=/tmp/hermes-phone-test/state.db
# PHONE_BRIDGE_PROJECTS_PATH=/tmp/hermes-phone-test/projects.json
# PHONE_BRIDGE_PROJECTS_FIXTURE=fixture.json
