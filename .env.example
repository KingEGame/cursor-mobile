# Hub bind — use Tailscale IP/hostname for phone reachability.
# Prefer Tailscale interface only; 0.0.0.0 only when Tailscale ACLs protect the port.
HUB_HOST=127.0.0.1
HUB_PORT=8787

# CDP must stay on loopback — phone never dials this URL.
CDP_URL=http://127.0.0.1:9222

# Optional: treat ALL selector-pack actions as VERIFIED (ops smoke only — not a DOM proof).
# Prefer flipping per-action CANDIDATE→VERIFIED in packages/adapters/live-cursor/src/selector-pack.ts
# after a manual Cursor UI check. See docs/CONFIGURATION.md "Marking a selector pack VERIFIED".
# LIVE_SELECTOR_PACK_READY=true

# Optional: force live-cursor CDP loopback probe in tests (auto-runs if :9222 already up).
# LIVE_CDP_PROBE=1

# Optional: bind workspace without CDP detection (Phase 0 env stub).
# CURSOR_WORKSPACE=/path/to/open/project

# Optional Phase 3: extra absolute roots for multi-root PC-open workspaces
# (comma-separated). Also supports pointing CURSOR_WORKSPACE at a .code-workspace file.
# CURSOR_WORKSPACE_ROOTS=/path/to/other_root,/path/to/shared_docs

# Optional: New Session model catalog (DESIGNED stub — not CDP scrape).
# Format: id, id:label, or id:label:family — mark default with id*
# CURSOR_MODELS=composer*:Composer:composer,auto:Auto:auto

# Optional: tools summary stubs for GET /workspace/tools
# CURSOR_MCP_SERVERS=filesystem:12,github:8
# CURSOR_PLUGINS=example-plugin

# Pairing
PAIRING_REQUIRED=true
PAIRING_CODE_TTL_SEC=300
PAIRING_TOKEN_TTL_SEC=

# Durable device tokens (Phase 4). Default ./data → data/devices.json. Use none for in-memory.
# HUB_DATA_DIR=./data

# Shown in pair QR / complete response
TAILSCALE_HOSTNAME=
HUB_DISPLAY_NAME=Desk PC
