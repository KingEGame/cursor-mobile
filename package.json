{
  "name": "hermes-phone",
  "version": "0.1.0",
  "private": true,
  "description": "Phone client for the Hermes Gateway phone bridge (Android APK). Server: ~/.hermes/plugins/phone_bridge",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test -w @cursor-mobile/mobile",
    "typecheck": "npm run typecheck -w @cursor-mobile/mobile",
    "e2e": "bash apps/mobile/scripts/e2e-bridge.sh",
    "start:mobile": "npm run start -w @cursor-mobile/mobile",
    "gate": "bash scripts/release-gate.sh",
    "release:apk": "bash scripts/release-apk-local.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "allowScripts": {}
}
