{
  "name": "cursor-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "PC-local Cursor companion — Hub + Android APK (Phase 0 scaffold)",
  "workspaces": [
    "packages/hub",
    "packages/mcp",
    "packages/adapters/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @cursor-mobile/live-cursor && npm run build -w @cursor-mobile/history && npm run build -w @cursor-mobile/hub && npm run build -w @cursor-mobile/mcp",
    "build:hub": "npm run build -w @cursor-mobile/hub",
    "start": "npm run start -w @cursor-mobile/hub",
    "test": "npm run test -w @cursor-mobile/hub && npm run test -w @cursor-mobile/live-cursor && npm run test -w @cursor-mobile/history && npm run test -w @cursor-mobile/mcp",
    "test:hub": "npm run test -w @cursor-mobile/hub",
    "test:phase0": "npm run test:phase0 -w @cursor-mobile/hub",
    "test:phase1": "npm run test:phase1 -w @cursor-mobile/hub && npm run test -w @cursor-mobile/live-cursor",
    "test:phase2": "npm run test:phase2 -w @cursor-mobile/hub && npm run test -w @cursor-mobile/history",
    "test:phase4": "npm run test:phase4 -w @cursor-mobile/hub && npm run test:mobile",
    "test:live-cursor": "npm run test -w @cursor-mobile/live-cursor",
    "test:history": "npm run test -w @cursor-mobile/history",
    "start:mobile": "npm run start -w @cursor-mobile/mobile",
    "start:hub:tailscale": "bash scripts/start-hub-tailscale.sh",
    "start:cursor:cdp": "bash scripts/start-cursor-cdp.sh",
    "relaunch:cursor:cdp": "bash scripts/relaunch-cursor-cdp-external.sh",
    "verify:cdp": "bash scripts/wait-cdp-and-verify.sh",
    "watch:cdp": "bash scripts/watch-cdp-and-verify.sh",
    "watch:peer": "bash scripts/watch-tailscale-peer-and-pair.sh",
    "watch:pixel-new-session": "bash scripts/watch-pixel-unlock-and-new-session.sh",
    "watch:main-cdp-new-session": "bash scripts/watch-main-cdp-and-new-session.sh",
    "assert:no-second-cdp": "bash scripts/assert-no-second-cdp-profile.sh",
    "uat:precheck": "bash scripts/uat-precheck.sh",
    "uat:negatives": "bash scripts/uat-negatives.sh",
    "uat:edges": "bash scripts/uat-edges.sh",
    "uat:mesh-drop": "bash scripts/uat-mesh-drop.sh",
    "uat:adb-live-send": "bash scripts/adb-live-chat-send-uat.sh",
    "uat:adb-approvals": "bash scripts/adb-approvals-uat.sh",
    "uat:adb-new-session": "bash scripts/adb-new-session-uat.sh",
    "typecheck:mobile": "npm run typecheck -w @cursor-mobile/mobile",
    "test:mobile": "npm run test -w @cursor-mobile/mobile",
    "gate": "bash scripts/release-gate.sh",
    "gate:full": "GATE_FULL=1 bash scripts/release-gate.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "release:apk": "bash scripts/release-apk-local.sh",
    "publish:apk": "node scripts/publish-apk-to-hub.mjs",
    "publish:apk:github": "node scripts/publish-apk-to-hub.mjs --from-github",
    "hub:service:install": "bash scripts/install-hub-service.sh",
    "start:desktop": "npm run package:desktop:bundle && npm run start -w @cursor-mobile/desktop",
    "package:desktop:bundle": "node scripts/package-desktop.mjs --bundle-only",
    "package:desktop": "node scripts/package-desktop.mjs",
    "package:desktop:linux": "node scripts/package-desktop.mjs --platform linux",
    "package:desktop:win": "node scripts/package-desktop.mjs --platform win",
    "package:desktop:mac": "node scripts/package-desktop.mjs --platform mac",
    "test:mcp": "npm run test -w @cursor-mobile/mcp",
    "mcp:install": "bash scripts/install-claude-mcp.sh"
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}
