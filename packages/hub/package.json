{
  "name": "@cursor-mobile/hub",
  "version": "0.1.0",
  "private": true,
  "description": "Local Hub HTTP/WS API — Phase 1: health, pair, workspace models/files/tools, live sessions, attachments, messages, approvals",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cursor-mobile-hub": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:phase0": "vitest run --config vitest.config.ts tests/phase0",
    "test:phase1": "vitest run --config vitest.config.ts tests/phase1",
    "test:phase2": "vitest run --config vitest.config.ts tests/phase2",
    "test:phase4": "vitest run --config vitest.config.ts tests/phase4",
    "test:watch": "vitest --config vitest.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cursor-mobile/history": "file:../adapters/history",
    "@cursor-mobile/live-cursor": "file:../adapters/live-cursor",
    "express": "^5.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
